# GEMINI_API_KEY: Required for Gemini AI API calls.
# Never commit a real key.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL where the terminal is hosted.
APP_URL="MY_APP_URL"

# Optional vessel/AIS provider integration.
# If omitted, the terminal explicitly uses repository demo vessel fixtures.
AIS_PROVIDER_URL=""
AIS_PROVIDER_KEY=""
